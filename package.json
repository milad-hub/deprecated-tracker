{
  "name": "deprecated-tracker",
  "displayName": "Deprecated Tracker",
  "description": "Find and manage deprecated code in TypeScript and JavaScript projects",
  "version": "2.6.1",
  "publisher": "milad445",
  "author": "Milad Jokar (https://github.com/milad-hub)",
  "license": "MIT",
  "homepage": "https://github.com/milad-hub/deprecated-tracker#readme",
  "bugs": {
    "url": "https://github.com/milad-hub/deprecated-tracker/issues"
  },
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.74.0",
    "node": ">=18"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "deprecated",
    "deprecation",
    "typescript",
    "javascript",
    "scanner",
    "code analysis",
    "technical debt",
    "cli",
    "pre-commit",
    "lint-staged",
    "ci",
    "sarif",
    "vscode-extension"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "bin": {
    "deprecated-tracker": "./bin/deprecated-tracker.js"
  },
  "contributes": {
    "commands": [
      {
        "command": "deprecatedTracker.scan",
        "title": "Deprecated Tracker: Scan Project"
      },
      {
        "command": "deprecatedTracker.refresh",
        "title": "Refresh",
        "icon": "$(sync)"
      },
      {
        "command": "deprecatedTracker.openResults",
        "title": "Open Results Panel"
      },
      {
        "command": "deprecatedTracker.ignoreFile",
        "title": "Deprecated Tracker: Ignore File"
      },
      {
        "command": "deprecatedTracker.updateTreeView",
        "title": "Update Tree View"
      },
      {
        "command": "deprecatedTracker.scanFolder",
        "title": "Deprecated Tracker: Scan Folder..."
      },
      {
        "command": "deprecatedTracker.scanFile",
        "title": "Deprecated Tracker: Scan File..."
      },
      {
        "command": "deprecatedTracker.scanChanges",
        "title": "Deprecated Tracker: Scan Changes",
        "icon": {
          "light": "media/scan-changes-light.svg",
          "dark": "media/scan-changes-dark.svg"
        }
      },
      {
        "command": "deprecatedTracker.exportResults",
        "title": "Deprecated Tracker: Export Results"
      },
      {
        "command": "deprecatedTracker.showStatistics",
        "title": "Deprecated Tracker: Show Statistics Dashboard"
      },
      {
        "command": "deprecatedTracker.checkRequirements",
        "title": "Deprecated Tracker: Check Requirements"
      },
      {
        "command": "deprecatedTracker.openSettings",
        "title": "Deprecated Tracker: Open Settings"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "deprecated-tracker-container",
          "title": "Deprecated Tracker",
          "icon": "media/activity-icon.svg"
        }
      ]
    },
    "views": {
      "deprecated-tracker-container": [
        {
          "id": "deprecatedTrackerSidebar",
          "name": "Deprecated Tracker",
          "icon": "media/activity-icon.svg",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "deprecatedTracker.scan",
          "when": "view == deprecatedTrackerSidebar",
          "group": "navigation"
        },
        {
          "command": "deprecatedTracker.refresh",
          "when": "view == deprecatedTrackerSidebar",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "deprecatedTracker.scanFolder",
          "when": "explorerResourceIsFolder",
          "group": "2_workspace@1"
        },
        {
          "command": "deprecatedTracker.scanFile",
          "when": "!explorerResourceIsFolder",
          "group": "2_workspace@2"
        },
        {
          "command": "deprecatedTracker.ignoreFile",
          "when": "!explorerResourceIsFolder",
          "group": "2_workspace@3"
        }
      ],
      "scm/title": [
        {
          "command": "deprecatedTracker.scanChanges",
          "when": "scmProvider == git",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "deprecatedTracker.refresh",
          "when": "false"
        },
        {
          "command": "deprecatedTracker.openResults",
          "when": "false"
        },
        {
          "command": "deprecatedTracker.updateTreeView",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run bundle",
    "bundle": "npm run copy-assets && esbuild ./src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --minify",
    "bundle:cli": "esbuild ./src/cli/index.ts --bundle --outfile=out/cli.js --format=cjs --platform=node --minify",
    "prepack": "npm run bundle:cli",
    "compile": "tsc -p ./",
    "build": "npm run compile && npm run bundle && npm run bundle:cli",
    "copy-assets": "node -e \"const fs = require('fs'); const path = require('path'); const srcDir = path.join('src', 'webview', 'assets'); const destDir = path.join('out', 'src', 'webview', 'assets'); fs.rmSync(destDir, { recursive: true, force: true }); fs.mkdirSync(destDir, { recursive: true }); fs.readdirSync(srcDir).forEach(file => { fs.copyFileSync(path.join(srcDir, file), path.join(destDir, file)); }); console.log('Assets copied successfully');\"",
    "dev": "tsc -watch -p ./",
    "lint": "eslint src --config config/eslint.config.js",
    "lint:fix": "eslint src --fix --config config/eslint.config.js",
    "format": "prettier --write \"src/**/*.ts\" \"src/webview/assets/**/*.{js,css}\" --config config/.prettierrc",
    "format:check": "prettier --check \"src/**/*.ts\" \"src/webview/assets/**/*.{js,css}\" --config config/.prettierrc",
    "test": "jest --config config/jest.config.js",
    "test:watch": "jest --watch --config config/jest.config.js",
    "pretest": "npm run compile",
    "test:coverage": "jest --coverage --config config/jest.config.js",
    "build-package": "node scripts/package.js",
    "build:web": "node scripts/build-web.js",
    "smoke:web": "node scripts/smoke-web.js",
    "publish-npm": "node scripts/publish.js",
    "publish-extension": "node scripts/publish-extension.js"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.3",
    "@types/vscode": "^1.74.0",
    "@typescript-eslint/eslint-plugin": "^8.50.1",
    "@typescript-eslint/parser": "^8.50.1",
    "esbuild": "^0.27.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^30.2.0",
    "prettier": "^3.7.4",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.1"
  },
  "overrides": {
    "@babel/core": "^7.29.6",
    "ajv@^6": "^6.14.0",
    "js-yaml@^3": "^3.15.1",
    "js-yaml@^4": "^4.3.1",
    "minimatch@^3": "^3.1.3",
    "minimatch@^9": "^9.0.7"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/milad-hub/deprecated-tracker.git"
  }
}
