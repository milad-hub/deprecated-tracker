# npm packaging only. vsce uses .vscodeignore, and it refuses to run when a
# "files" property also exists in package.json — so the npm side is expressed
# here instead.
#
# npm prefers this file over .gitignore, which is the point: .gitignore hides
# out/, so without this the published package would carry bin/ without the
# out/cli.js it requires.

src/
tests/
config/
scripts/
web/
coverage/
media/
.github/
.vscode/
.vscode-test/
graphify-out/

# Only the CLI bundle ships to npm. The extension bundle and the webview
# assets are the .vsix's job.
out/extension.js
out/src/

artifacts/
*.tmp
*.log
.deprecated-tracker-baseline.json
.vscodeignore
tsconfig.json
eslint.config.js
icon.png
docs/README.vscode.md
docs/README.npm.md

# Screenshots for the READMEs. The listings reference them by absolute URL, so
# a tarball copy would be 548 KB nobody reads.
docs/images/
ROADMAP.md
ISSUES.md
RTK.md

# Contributor-facing docs. SECURITY.md deliberately stays: someone auditing an
# installed package has a reason to find the disclosure process in it.
CONTRIBUTING.md
CODE_OF_CONDUCT.md
